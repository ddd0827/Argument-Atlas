# 不配置任何变量也能运行：默认使用完全离线的演示模式（Mock）。
# 想接入真实模型时，取消下面一行的注释并填入自己的 Key。
# DEEPSEEK_API_KEY=sk-...

# 兼容 OpenAI 协议的服务地址；默认 DeepSeek 官方接口
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# auto = 有 Key 走真实模型，没有 Key 走演示模式；也可强制 live / mock
# ATLAS_MODE=auto

# 默认模型（deepseek-flash 对 JSON 结构化输出支持最好；deepseek-chat 会映射到它）
# ATLAS_MODEL=deepseek-flash

# 数据库位置（相对路径基于项目根目录）
# ATLAS_DB=atlas.db

# 输入长度限制
# ATLAS_MIN_INPUT_CHARS=30
# ATLAS_MAX_INPUT_CHARS=12000
